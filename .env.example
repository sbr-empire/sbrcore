# 🔐 SBR EMPIRE - ENVIRONMENT CONFIGURATION
# Copy to .env and fill with actual values
# WARNING: Never commit .env file - Only use .env.example

# ==========================================
# GOOGLE CLOUD CONFIGURATION
# ==========================================
GCP_PROJECT_ID=sbr-core-project
GCP_REGION=asia-south1
GCP_ZONE=asia-south1-a

# Service Account (Get from Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ==========================================
# SECRET MANAGER KEYS (12 Keys as specified)
# ==========================================

# 1. Google Cloud Primary Key
SBR_GOOGLE_KEY_01=your-google-cloud-key-here

# 2. Gemini API (Advanced AI)
SBR_GEMINI_API_KEY_02=your-gemini-api-key-here

# 3. OpenAI API (ChatGPT for Tafsir)
SBR_OPENAI_API_KEY_03=your-openai-api-key-here

# 4. Google Cloud Storage API
SBR_CLOUD_API_KEY_04=your-gcs-api-key-here

# 5. NVIDIA API (GPU Processing for Quantum prep)
SBR_NVIDIA_API_KEY_05=your-nvidia-api-key-here

# 6. Weather API (sbrbioforge - Environmental data)
SBR_WEATHER_API_KEY_06=your-weather-api-key-here

# 7. Amber Energy API (Environmental data)
SBR_AMBER_API_KEY_07=your-amber-api-key-here

# 8. ElevenLabs API (Text-to-Speech - Neural voices)
SBR_ELEVENLABS_KEY_08=your-elevenlabs-api-key-here

# 9. LUMA AI (Video generation)
SBR_LUMA_API_KEY_09=your-luma-api-key-here

# 10. GROQ API (Fast inference - Quantum ready)
SBR_GROQ_API_KEY_10=your-groq-api-key-here

# 11. NASA API (Environmental monitoring)
SBR_NASA_API_KEY_11=your-nasa-api-key-here

# 12. AirNow API (Air quality data)
SBR_AIRNOW_API_KEY_12=your-airnow-api-key-here

# ==========================================
# DATABASE CONFIGURATION (Quantum + Blockchain Ready)
# ==========================================

# Cloud SQL (PostgreSQL)
DATABASE_URL=postgresql://user:password@cloud-sql-instance:5432/sbrempire
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30

# Redis Cache (Real-time features)
REDIS_URL=redis://default:password@redis-instance:6379/0
REDIS_TTL=3600

# Firestore (Real-time, NoSQL)
FIRESTORE_DATABASE=projects/sbr-core-project/databases/default
FIRESTORE_EMULATOR_HOST=localhost:8080

# ==========================================
# AUTHENTICATION & SECURITY (Post-Quantum Ready)
# ==========================================

# JWT Secrets
JWT_SECRET_KEY=your-super-secret-jwt-key-min-64-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# OAuth2
OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-secret

OAUTH_GITHUB_CLIENT_ID=your-github-oauth-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-oauth-secret

# Encryption Keys (Quantum-compatible)
ENCRYPTION_MASTER_KEY=your-encryption-master-key-64-chars
ENCRYPTION_ALGORITHM=AES-256-GCM

# ==========================================
# PAYMENT GATEWAY (Stripe + Razorpay)
# ==========================================

# Stripe (International)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Razorpay (India)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ==========================================
# BLOCKCHAIN & WEB3 (2030+ Ready)
# ==========================================

# Ethereum Network
ETH_NETWORK=mainnet
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
ETH_PRIVATE_KEY=your-ethereum-private-key

# Smart Contracts
SMART_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
SMART_CONTRACT_ABI=/path/to/contract-abi.json

# IPFS (Decentralized Storage)
IPFS_GATEWAY_URL=https://gateway.pinata.cloud
IPFS_API_KEY=your-pinata-api-key
IPFS_API_SECRET=your-pinata-api-secret

# ==========================================
# QUANTUM COMPUTING PREPARATION (2030+)
# ==========================================

QUANTUM_READY=true
QUANTUM_ENCRYPTION_ENABLED=true
QUANTUM_KEY_SIZE=4096
POST_QUANTUM_ALGORITHM=CRYSTALS-Kyber

# ==========================================
# AI MODELS & LLMS (Advanced)
# ==========================================

# LLaMA Model (Self-hosted, Quantum-ready)
LLAMA_MODEL_PATH=/models/llama-70b-instruct
LLAMA_GPU_MEMORY=40GB
LLAMA_CONTEXT_WINDOW=8192

# Anthropic Claude
ANTHROPIC_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-opus-20240229

# Google Generative AI
GOOGLE_GENERATIVE_AI_KEY=$SBR_GEMINI_API_KEY_02

# Vector Database (For Retrieval Augmented Generation)
VECTOR_DB_TYPE=pinecone
VECTOR_DB_API_KEY=your-pinecone-api-key
VECTOR_DB_ENVIRONMENT=production

# ==========================================
# QURAN & HADITH DATA (sbrhikmah)
# ==========================================

# Quran API
QURAN_API_URL=https://api.quran.com/api/v4
QURAN_MIRROR_DB_PATH=/data/quran-mirror

# Hadith Collections
HADITH_SAHIH_BUKHARI_PATH=/data/hadith/sahih-bukhari
HADITH_SAHIH_MUSLIM_PATH=/data/hadith/sahih-muslim
HADITH_SUNAN_ABU_DAWOOD_PATH=/data/hadith/sunan-abu-dawood
HADITH_SUNAN_TIRMIDHI_PATH=/data/hadith/sunan-tirmidhi
HADITH_SUNAN_NASAI_PATH=/data/hadith/sunan-nasai
HADITH_SUNAN_IBN_MAJAH_PATH=/data/hadith/sunan-ibn-majah

# Arabic NLP (Natural Language Processing)
ARABIC_NLP_MODEL=farasa-enhanced
ARARIC_TOKENIZER=arabert

# ==========================================
# ENVIRONMENTAL DATA (sbrbioforge)
# ==========================================

# Water Quality Data
WATER_QUALITY_DB_URL=postgresql://user:pass@water-db:5432/quality

# Pollution Monitoring
POLLUTION_SENSOR_NETWORK_API=https://api.air-quality.io
POLLUTION_HISTORICAL_DATA_PATH=/data/pollution-history

# Health Database
HEALTH_TREATMENT_DB_PATH=/data/health-treatments
HEALTH_SOLUTIONS_API=https://api.health-solutions.io

# ==========================================
# LUXURY & E-COMMERCE (sbrbeautyhub)
# ==========================================

# Product Catalog
PRODUCT_DB_TYPE=elasticsearch
PRODUCT_DB_URL=https://elastic:password@elasticsearch:9200

# Luxury Brand Verification
BRAND_VERIFICATION_DB=postgresql://user:pass@brand-db:5432/luxury
ANTI_COUNTERFEIT_API=https://api.verify-luxury.io

# ==========================================
# LOGGING & MONITORING (Enterprise)
# ==========================================

# Google Cloud Logging
LOGGING_ENABLED=true
LOGGING_LEVEL=INFO
GOOGLE_CLOUD_LOGGING_ENABLED=true

# Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ERROR_REPORTING_ENABLED=true

# Performance Monitoring
GOOGLE_CLOUD_TRACE_ENABLED=true
GOOGLE_CLOUD_PROFILER_ENABLED=true

# ==========================================
# CONTENT MODERATION (sbrhikmah Reels)
# ==========================================

# Hate Speech Detection
HATE_SPEECH_MODEL=perspective-api
HATE_SPEECH_THRESHOLD=0.8

# Content Filtering
CONTENT_FILTER_ENABLED=true
FILTER_EXPLICIT_CONTENT=true
HALAL_VERIFICATION_ENABLED=true

# ==========================================
# NEURAL INTERFACE PREP (2030+ Feature)
# ==========================================

NEURAL_INTERFACE_ENABLED=false
NEURAL_INTERFACE_TYPE=eeg-based
NEURAL_INTERFACE_SAMPLING_RATE=1000

# ==========================================
# ROBOTICS FRAMEWORK (2030+ Feature)
# ==========================================

ROBOTICS_ENABLED=false
ROBOT_IMAM_MODEL=humanoid-v1
ROBOT_CONTROL_PROTOCOL=mqtt

# ==========================================
# METAVERSE INTEGRATION (2030+ Feature)
# ==========================================

METAVERSE_ENABLED=false
METAVERSE_PLATFORM=unity-netcode
HOLOGRAPHIC_RENDERING_ENABLED=false

# ==========================================
# ENVIRONMENT
# ==========================================

NODE_ENV=production
PYTHON_ENV=production

# Server
PORT=8000
API_PORT=3000
WEBSOCKET_PORT=3001

# Domain
API_DOMAIN=api.sbrhikmah.com
WEB_DOMAIN=sbrhikmah.com
CDN_DOMAIN=cdn.sbrhikmah.com

# ==========================================
# SECURITY HEADERS
# ==========================================

CORS_ORIGINS=https://sbrhikmah.com,https://sbrbioforge.com,https://sbrbeautyhub.com
CSRF_ENABLED=true
RATE_LIMITING_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# ==========================================
# TESTING & DEBUG (Dev only)
# ==========================================

DEBUG=false
TEST_MODE=false
MOCK_PAYMENTS=false
